# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
# Nothing in this file may be a real credential.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Secure, HTTPS-only session and CSRF cookies -- required by docs/requirements.md
# section 3. Defaults to the opposite of DJANGO_DEBUG, so anything running with
# DEBUG off gets them without having to remember this line. Set it to False only
# for a staging box deliberately served over plain HTTP.
# DJANGO_SECURE_COOKIES=True

# PostgreSQL in development as well as production -- docs/adr/0004-database.md.
#
# Local cluster: scripts/dev.py starts it if it is down (it never stops it) --
# at %USERPROFILE%\Binaries\pgsql, or PGSQL_HOME. The first time, start it
# directly and create the database:
#
#   "%USERPROFILE%\Binaries\pgsql\bin\pg_ctl" start -D "%USERPROFILE%\Binaries\pgsql\data" -l "%USERPROFILE%\Binaries\pgsql\server.log"
#   "%USERPROFILE%\Binaries\pgsql\bin\createdb" -U postgres questionable_candy
#
# Check it is up with `pg_isready -h localhost -p 5432` (exit code 0 = ready).
# That cluster's pg_hba.conf uses `trust` on localhost, so no password is needed
# and it listens on localhost only. Convenient for development; never ship it.
DATABASE_URL=postgresql://postgres@localhost:5432/questionable_candy

# Any other PostgreSQL 17 (a system service, Homebrew, a container): a user with
# a password and CREATEDB, which the test suite needs. Percent-encode special
# characters in the password (README "Running it").
# DATABASE_URL=postgresql://candy:PASSWORD@localhost:5432/questionable_candy

# Deployed alternative (Neon). Keep the -pooler host and the ?sslmode=require
# suffix; the pooled endpoint idles the compute and drops connections after
# ~5 minutes, which is what conn_health_checks in settings.py handles.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/questionable_candy?sslmode=require


# Production (DEBUG off). SSL redirect defaults on and HSTS to one hour; override
# only for a staging box on plain HTTP. Behind a TLS-terminating proxy set the
# proxy header flag, or the redirect loops.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600
# DJANGO_PROXY_SSL_HEADER=True
# Behind a proxy that overwrites a client-IP header (Render: CF-Connecting-IP),
# so login throttling sees each visitor's address rather than the proxy's.
# Leave unset without one: a visitor could then send the header themselves.
# DJANGO_CLIENT_IP_HEADER=CF-Connecting-IP
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=
# DJANGO_EMAIL_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True

