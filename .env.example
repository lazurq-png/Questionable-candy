# Copy this file to .env and fill in real values. .env is gitignored; this file is not.

# Generate one with:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon pooled connection string — Project dashboard > Connect > Connection string.
# Keep the -pooler host and the ?sslmode=require suffix.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/questionable_candy?sslmode=require
